# Copie para .env (que o git ignora) e preencha TODOS os valores. Nunca commite o .env.

# Fuso horário dos containers
TZ=America/Sao_Paulo

# Banco (o Postgres cria o banco e o usuário com estes valores na primeira subida)
DB_NAME=studymind_redacao
DB_USERNAME=studymind
DB_PASSWORD=troque-por-uma-senha-forte
# Host "db" = nome do serviço no compose (não use localhost). O nome do banco no fim deve ser igual ao DB_NAME.
DB_URL=jdbc:postgresql://db:5432/studymind_redacao
# Porta do banco na máquina (só em 127.0.0.1); 5433 para não brigar com um Postgres local
DB_PORTA_HOST=5433

# API: 127.0.0.1 com proxy HTTPS na frente (recomendado na VPS); 0.0.0.0 para acesso direto
API_BIND=127.0.0.1
API_PORTA_HOST=8080

# JWT: pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=120

# Gemini
GEMINI_API_KEY=sua-chave-do-gemini
# Júlia (assistente): chave de um projeto separado do Google Cloud
JULIA_GEMINI_API_KEY=sua-chave-da-julia
# Transcrição por imagem: chave de OUTRO projeto Google Cloud (diferente da correção e da Júlia, senão a API não sobe)
TRANSCRICAO_GEMINI_API_KEY=sua-chave-da-transcricao

# URL do frontend que pode chamar a API (várias separadas por vírgula, sem barra no final)
CORS_ORIGENS=http://localhost:5173

# Cadastro: fechado; só os e-mails da lista (separados por vírgula) criam conta
CADASTRO_ABERTO=false
CADASTRO_EMAILS_PERMITIDOS=

# Limites de correção
LIMITE_CORRECOES_DIARIAS=3
LIMITE_CORRECOES_GLOBAL=30

# Limites de transcrição de foto (cota própria, separada das correções)
LIMITE_TRANSCRICOES_DIARIAS=3
LIMITE_TRANSCRICOES_GLOBAL=30

# Chamadas simultâneas à IA por recurso (opcional; sem a variável vale o padrão)
# IA_CONCORRENCIA_CORRECAO=4
# IA_CONCORRENCIA_TRANSCRICAO=2
# IA_CONCORRENCIA_JULIA=4
# Modelo da transcrição; deixe igual ao da correção se não quiser separar
GEMINI_MODELO_TRANSCRICAO=gemini-3.5-flash-lite
# Correção (#25): modelo e nível de raciocínio (minimal | low | medium | high)
GEMINI_MODELO_AVALIACAO=gemini-3.5-flash-lite
GEMINI_RACIOCINIO_AVALIACAO=medium
GEMINI_TIMEOUT_SEGUNDOS=60

# E-mail (verificação de conta). false até a feature existir.
# Com true, MAIL_USERNAME, MAIL_PASSWORD e APP_FRONTEND_URL são obrigatórios ou a API não sobe.
EMAIL_HABILITADO=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=kellyacademy@gmail.com
# Gmail: senha de app gerada em myaccount.google.com/apppasswords (não é a senha da conta)
MAIL_PASSWORD=sua-senha-de-app
# Nome que aparece como remetente na caixa de entrada do aluno
MAIL_REMETENTE_NOME=Kelly Academy
# Base dos links do e-mail: https (ou http só em localhost), sem barra no final
APP_FRONTEND_URL=http://localhost:5173

# native com proxy/HTTPS (Nginx, Caddy) na frente da API; none sem proxy
FORWARD_HEADERS=none
