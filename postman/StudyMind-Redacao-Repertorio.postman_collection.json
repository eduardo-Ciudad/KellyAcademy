    {
      "name": "1. Macroeixos",
      "item": [
        {
          "name": "Macroeixos com problemas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"13 macroeixos\", () => pm.expect(body.length).to.eql(13));",
                  "pm.test(\"52 problemas no total\", () => pm.expect(body.reduce((n, m) => n + m.problemas.length, 0)).to.eql(52));",
                  "pm.test(\"Cada problema aponta para o próprio macroeixo\", () => body.forEach(m => m.problemas.forEach(p => pm.expect(p.macroeixo).to.eql(m.slug))));",
                  "pm.test(\"Ordem numérica não vaza\", () => pm.expect(body[0]).to.not.have.property(\"ordem\"));",
                  "pm.collectionVariables.set(\"macroeixoSlug\", body[0].slug);",
                  "pm.collectionVariables.set(\"problemaSlug\", body[0].problemas[0].slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/macroeixos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macroeixos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
