      "name": "0. Setup",
      "item": [
        {
          "name": "Cadastro aluno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Repertório\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `aluno.repertorio.${Date.now()}@teste.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login aluno",
          "request": {
            "method": "POST",
