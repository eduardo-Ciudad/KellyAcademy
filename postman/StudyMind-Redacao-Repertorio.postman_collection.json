              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const PRIVADOS = [\"id\", \"pontuacao\", \"notaVersatilidade\", \"tags\", \"tiposArgumento\", \"statusVerificacao\", \"verificadoEm\", \"ativo\"];",
                  "pm.test(\"63 repertórios ativos\", () => pm.expect(body.totalItens).to.eql(63));",
                  "pm.test(\"Tamanho padrão 20\", () => { pm.expect(body.tamanho).to.eql(20); pm.expect(body.itens.length).to.eql(20); });",
                  "pm.test(\"4 páginas e tem próxima\", () => { pm.expect(body.totalPaginas).to.eql(4); pm.expect(body.temProxima).to.be.true; });",
                  "pm.test(\"Card sem campos internos\", () => PRIVADOS.forEach(c => pm.expect(body.itens[0]).to.not.have.property(c)));",
                  "pm.test(\"Card com os campos da issue\", () => [\"codigo\", \"nome\", \"subtitulo\", \"tipo\", \"tipoDescricao\", \"lembreNaProva\", \"saturacao\", \"riscoUso\", \"problemas\"].forEach(c => pm.expect(body.itens[0]).to.have.property(c)));",
                  "pm.collectionVariables.set(\"codigo\", body.itens[0].codigo);"
                ]
              }
            }
          ],
