    {
      "name": "6. GET /temas traz o personalizado primeiro",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/temas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "temas"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const lista = pm.response.json();",
              "pm.test(\"Primeiro da lista é o tema criado\", () => pm.expect(lista[0].id).to.eql(pm.collectionVariables.get(\"temaId\")));"
            ]
          }
        }
      ]
    }
  ],
