{
  "info": {
    "_postman_id": "83370fc2-b327-4090-b962-eb439c245456",
    "name": "StudyMind Redação — Temas personalizados",
    "description": "Tema digitado pelo aluno (POST /temas/personalizados).\n\nPreencha as variáveis email e senha com uma conta local já verificada e rode pelo Runner, na ordem.\nCada execução cria 1 tema novo (conta no limite de 10 por dia). Não gasta correção nem chama o Gemini.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Criar tema personalizado (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/temas/personalizados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "temas",
            "personalizados"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"  {{tituloTema}}  \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Título único por execução, para o passo 1 sempre criar",
              "pm.collectionVariables.set(\"tituloTema\", `Tema de teste do Postman ${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const t = pm.response.json();",
              "pm.test(\"Origem PERSONALIZADO\", () => pm.expect(t.origem).to.eql(\"PERSONALIZADO\"));",
              "pm.test(\"Título normalizado\", () => pm.expect(t.titulo).to.eql(pm.collectionVariables.get(\"tituloTema\")));",
              "pm.test(\"Não expõe o dono\", () => pm.expect(t).to.not.have.property(\"criadoPorId\"));",
              "pm.collectionVariables.set(\"temaId\", t.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Mesmo título em maiúsculas devolve o existente (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/temas/personalizados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "temas",
            "personalizados"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"{{tituloTemaMaiusculo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"tituloTemaMaiusculo\", pm.collectionVariables.get(\"tituloTema\").toUpperCase());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Mesmo id do passo 1\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"temaId\")));"
            ]
          }
        }
      ]
    },
