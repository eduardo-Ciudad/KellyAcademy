              "pm.test(\"Plano PRO\", () => pm.expect(p.plano).to.eql(\"PRO\"));",
              "pm.test(\"Origem ASSINATURA\", () => pm.expect(p.origem).to.eql(\"ASSINATURA\"));",
              "pm.test(\"cancelarNoFimDoPeriodo = false\", () => pm.expect(p.assinatura.cancelarNoFimDoPeriodo).to.eql(false));",
              "pm.test(\"Limites do Pro (10 correções, 10 transcrições)\", () => pm.expect(p.limites).to.eql({ correcoesPorDia: 10, transcricoesPorDia: 10 }));",
              "console.log(\"Período atual até:\", p.assinatura.periodoAtualFim);"
            ]
          }
        }
      ]
    },
