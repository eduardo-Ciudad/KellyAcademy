    {
      "name": "2. Conversa (gasta 2 perguntas da Júlia)",
      "item": [
        {
          "name": "Primeira pergunta (200, chama o Gemini)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/redacoes/{{redacaoId}}/julia/mensagens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "redacoes",
                "{{redacaoId}}",
                "julia",
                "mensagens"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pergunta\": \"Qual competência mais pesou na minha nota e por quê?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Pergunta e resposta salvas, com id\", () => {",
                  "    pm.expect(b.pergunta.id).to.be.a(\"string\");",
                  "    pm.expect(b.pergunta.papel).to.eql(\"USUARIO\");",
                  "    pm.expect(b.resposta.id).to.be.a(\"string\");",
                  "    pm.expect(b.resposta.papel).to.eql(\"JULIA\");",
                  "    pm.expect(b.resposta.conteudo).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"Não expõe tokens\", () => pm.expect(b.resposta).to.not.have.any.keys(\"tokensEntrada\", \"tokensSaida\"));",
                  "console.log(\"Júlia:\", b.resposta.conteudo);",
                  "pm.test(\"Restam 9 na conversa\", () => pm.expect(b.restantesConversa).to.eql(9));"
                ]
              }
            }
          ]
        },
        {
