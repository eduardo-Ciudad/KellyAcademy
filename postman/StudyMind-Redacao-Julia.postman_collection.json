          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const temas = pm.response.json();",
                  "pm.test(\"Traz os 8 temas oficiais do seed\", () => pm.expect(temas.length).to.be.at.least(8));",
                  "pm.test(\"Ordenados do mais recente para o mais antigo\", () => {",
                  "    const anos = temas.filter(t => t.ano).map(t => t.ano);",
                  "    pm.expect(anos).to.eql([...anos].sort((a, b) => b - a));",
                  "});",
                  "const cinema = temas.find(t => t.ano === 2019);",
                  "pm.test(\"Tema de 2019 (cinema) disponível\", () => pm.expect(cinema).to.be.an(\"object\"));",
                  "pm.collectionVariables.set(\"temaId\", cinema.id);"
                ]
              }
            }
          ]
