        {
          "name": "Enviar redação corrigida (201, gasta 1 correção)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/redacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "redacoes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temaId\": \"{{temaId}}\",\n  \"tipo\": \"PRATICA\",\n  \"texto\": {{textoRedacaoJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "description": "Chama o Gemini de verdade e gasta 1 das 3 correções do dia do aluno A. Pode levar de 10 a 30 segundos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const b = pm.response.json();",
                  "pm.test(\"Redação avaliada com o tema escolhido\", () => {",
                  "    pm.expect(b.status).to.eql(\"AVALIADA\");",
                  "    pm.expect(b.tema.id).to.eql(pm.collectionVariables.get(\"temaId\"));",
                  "    pm.expect(b.avaliacao).to.be.an(\"object\");",
                  "});",
                  "pm.test(\"5 competências, C1 a C5, só com notas oficiais\", () => {",
                  "    const c = b.avaliacao.competencias;",
                  "    pm.expect(c.map(x => x.numero)).to.eql([1, 2, 3, 4, 5]);",
                  "    c.forEach(x => pm.expect([0, 40, 80, 120, 160, 200]).to.include(x.nota));",
                  "    c.forEach(x => pm.expect(x.resumo).to.be.a(\"string\").and.not.empty);",
                  "});",
                  "pm.test(\"notaTotal é a soma das competências\", () => {",
                  "    const soma = b.avaliacao.competencias.reduce((s, x) => s + x.nota, 0);",
                  "    pm.expect(b.avaliacao.notaTotal).to.eql(soma);",
                  "});",
                  "pm.test(\"Não expõe dados internos da IA\", () => {",
                  "    pm.expect(b.avaliacao).to.not.have.any.keys(\"modeloIa\", \"tokensEntrada\", \"tokensSaida\", \"respostaBrutaJson\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"redacaoId\", b.id);",
                  "pm.collectionVariables.set(\"notaTotal\", b.avaliacao.notaTotal);",
                  "console.log(\"Nota:\", b.avaliacao.notaTotal, \"| Diagnóstico:\", b.avaliacao.diagnostico);"
                ]
              }
            }
          ]
        }
      ]
