                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Série com 30 dias\", () => pm.expect(j.serieDiaria).to.have.length(30));",
                  "pm.test(\"5 faixas e 5 competências\", () => { pm.expect(j.distribuicaoNotas).to.have.length(5); pm.expect(j.mediaPorCompetencia).to.have.length(5); });",
                  "pm.test(\"3 recursos de IA\", () => pm.expect(j.usoIaHoje.map(u => u.recurso)).to.eql([\"CORRECAO\", \"TRANSCRICAO\", \"JULIA\"]));"
                ]
              }
            }
          ]
